<?xml version="1.0" encoding="utf-8"?>
<!--
    The development loop's package sources. Copied over nuget.config by the Dockerfile when
    built with DEPS=local, and usable directly on a workstation by passing it to dotnet restore
    as the configfile.

    The difference from nuget.config is only where NexusKit.* comes from: a folder this repo
    produces rather than GitHub Packages. That is the whole point — during development the
    interesting version of NexusKit.Sync is the one in the sibling clone, which by definition
    has not been published yet.

    No credentials here, and none needed: a folder source has nothing to authenticate against.
    That also means this file is safe to commit, unlike the one it stands in for.

    The path is relative to where this file ends up, which is /src — the repository root inside
    the image — not to this directory.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packages" value="./localdev/packages" />
  </packageSources>

  <!-- Same reason as in nuget.config: central package management raises NU1507 for more than
       one unmapped source, and warnings are errors here. Longest matching pattern wins, so
       NexusKit.* comes from the folder and everything else from nuget.org.

       Note what is absent — the GitHub feed. With it mapped alongside, NuGet would resolve the
       highest version across both sources, and a published 0.5.2 would quietly beat the local
       0.5.1 that carries the change being tested. A local build must build what is local. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="NexusKit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
