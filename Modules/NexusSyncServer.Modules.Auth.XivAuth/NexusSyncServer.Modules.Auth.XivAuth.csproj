<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>NexusSyncServer.Modules.Auth.XivAuth</RootNamespace>
		<AssemblyName>NexusSyncServer.Modules.Auth.XivAuth</AssemblyName>
		<Description>XIVAuth sign-in for NexusSyncServer. Ties an account to a verified FINAL FANTASY XIV character, which is a far stronger anti-abuse gate than any rate limit.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NexusSyncServer.Modules.Auth\NexusSyncServer.Modules.Auth.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
