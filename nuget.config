<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    `local-packages` exists for the container build.

    Inside the image there are no sibling clones, so the workspace's
    Directory.Build.targets cannot swap NexusKit.Sync for a ProjectReference — it has to
    restore as a package. Until it is published to GitHub Packages, that package exists
    nowhere the container can reach, and `docker compose build` fails with NU1101.

    Rather than making the image unbuildable until the first publish, scripts/pack-local-deps
    packs the sibling NexusKit.Sync into ./local-packages, and this source picks it up. Once
    the package is on the feed the folder can simply stay empty — a published version wins on
    version anyway, and an empty local source costs nothing.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-packages" value="./local-packages" />
  </packageSources>

</configuration>
