<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>NexusSyncServer.Hosting</RootNamespace>
		<AssemblyName>NexusSyncServer.Hosting</AssemblyName>
		<Description>The NexusSyncServer module model: IServerModule, endpoint and page seams, per-module persistence contracts, and the composition root. Reference this to write your own server module.</Description>
		<IsPackable>true</IsPackable>
		<Deterministic>true</Deterministic>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Routing, WebApplication, the endpoint builder. A FrameworkReference rather than
		     packages: the shared framework is already in the container base image, so pulling
		     the same types as NuGet would only add weight and a version to keep in step. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" />
		<None Include="docs\**\*.md" />
	</ItemGroup>
</Project>
