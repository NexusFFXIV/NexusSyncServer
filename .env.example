# Copy to .env and edit. .env is gitignored.
#
# Every value here has a working default — an empty .env still brings the stack up.

# --- database ------------------------------------------------------------------------------
# Local development defaults. Change both for anything reachable from outside this machine.
DB_PASSWORD=nexussyncserver
DB_ROOT_PASSWORD=nexussyncserver

# --- server --------------------------------------------------------------------------------
SERVER_PORT=8080
VERSION=0.0.0-local

# --- phpMyAdmin ------------------------------------------------------------------------------
# Development convenience for looking into the database. Bound to 127.0.0.1 only, and it has
# no place in a production deployment — drop the service from the compose file there.
PHPMYADMIN_PORT=8081

# Signed in automatically with these. Defaults to the application user, which sees exactly the
# one database the server uses. Clear both to get the login prompt back — needed to sign in as
# root, since the application user cannot see the system databases.
# PHPMYADMIN_USER=nexussyncserver
# PHPMYADMIN_PASSWORD=nexussyncserver

# --- sign-in providers ----------------------------------------------------------------------
# Both are off unless enabled. A server with neither is a valid deployment — keys are then
# issued by the operator with `--issue-key`.

# XIVAuth ties an account to a verified FINAL FANTASY XIV character, which is a far stronger
# anti-abuse gate than any rate limit: an attacker needs a real game account per identity.
XIVAUTH_ENABLED=false
XIVAUTH_CLIENT_ID=
XIVAUTH_CLIENT_SECRET=

DISCORD_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# provider:subject — seeds an operator, needed once to break the bootstrap circle, since
# registering a contract requires an operator and promoting one does too.
# OPERATOR_IDENTITY=xivauth:12345

# --- credentials directory --------------------------------------------------------------
# Where credential files are read from. Defaults to ./secrets inside the repo, which is
# convenient and fine for local work — but point it outside for anything real. A credentials
# folder in a working tree is one `git add -f`, one archived copy or one file-sync client
# away from leaking.
# SECRETS_DIR=/etc/nexussyncserver/secrets

# --- bootstrap key (optional) --------------------------------------------------------------
# Unattended provisioning: a key seeded at startup so a deployment comes up without anyone
# running a command. The key itself is a FILE, never a variable — variables show up in
# `docker inspect`, in this file, in shell history and in /proc.
#
#   openssl rand -hex 16 | tr -d '\n' | tr 'ilou' 'jkmn' | sed 's/^/nxs_/' > secrets/bootstrap_key
#
# Seeding is idempotent. Remove these once a real key has been issued; the server warns at
# every start until you do.
# BOOTSTRAP_KEY_FILE=/run/secrets/bootstrap_key
# BOOTSTRAP_KEY_SCOPE_0=reference_items:pull
# BOOTSTRAP_KEY_CONTRACT=example.showcase
